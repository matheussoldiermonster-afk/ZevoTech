DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/zevo_tech"
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="gere-uma-chave-aleatoria-com-48-bytes"
JWT_EXPIRES_IN="8h"
PORT=3333
NODE_ENV=development
# Origens permitidas (separe várias por vírgula)
CORS_ORIGIN="http://localhost:5173"
# Fuso usado para "hoje", meses e relatórios
APP_TIMEZONE="America/Sao_Paulo"
# Defina se a API ficar atrás de proxy reverso (nginx etc.): true ou número de saltos
# TRUST_PROXY=true
# Usuário inicial criado pelo seed
# SEED_ADMIN_EMAIL="admin@zevotech.com"
# SEED_ADMIN_PASSWORD="defina-uma-senha-forte"

# ---------------- Backup do banco (ver BACKUP.md) ----------------
# Liga o backup automático diário feito pela própria API
BACKUP_ENABLED=true
# Horário diário (fuso APP_TIMEZONE)
BACKUP_TIME="02:00"
# Pasta principal dos backups (padrão: backend/backups)
# BACKUP_DIR="C:/ZevoBackups"
# Segunda cópia, FORTEMENTE recomendada: pasta sincronizada (Google Drive,
# OneDrive, Dropbox) ou HD externo/pasta de rede
# BACKUP_COPY_DIR="C:/Users/SEU_USUARIO/Google Drive/Zevo Backups"
# Quantos backups manter
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# Pasta do pg_dump/pg_restore, se não estiverem no PATH
# Windows: PG_BIN_DIR="C:/Program Files/PostgreSQL/16/bin"
# PG_BIN_DIR=
